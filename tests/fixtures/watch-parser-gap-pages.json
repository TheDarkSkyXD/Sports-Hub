  "ihdPlayer": "<div class=\"match-title\">Florida Panthers at Buffalo Sabres</div><script>\nvar _k=\"4a7a811dxx\";\nvar _e1=\"L2VtYmVkL25obC9jaDEucGhw\";\nvar _e2=\"\";\n\nfunction decodeUrl(raw){\n    var d=atob(raw);\n    var xd=d.split('').map(function(c,i){return String.fromCharCode(c.charCodeAt(0)^_k.charCodeAt(i%_k.length));}).join('');\n    var p1=btoa(xd.slice(0,Math.floor(xd.length/2)));\n    var p2=btoa(xd.slice(Math.floor(xd.length/2)));\n    var j=atob(p1)+atob(p2);\n    return j.split('').map(function(c,i){return String.fromCharCode(c.charCodeAt(0)^_k.charCodeAt(i%_k.length));}).join('');\n}\n\nfunction updateModernServerUI(n){\n    var a1=document.getElementById('srv1Badge'), a2=document.getElementById('srv2Badge');\n    var chip=document.getElementById('serverStatusText');\n    if(a1)a1.textContent=n===1?'ACTIVE':'READY';\n    if(a2)a2.textContent=n===2?'ACTIVE':'READY';\n    if(chip)chip.textContent='SERVER '+n+' ACTIVE';\n}\n\nfunction switchServer(n){\n    var raw=n===1?_e1:_e2;\n    if(!raw)return;\n    var url=decodeUrl(raw);\n    if(!url)return;\n    var wrap=document.getElementById('playerWrap');\n    var ex=document.getElementById('mainFrame');\n    if(ex)ex.remove();\n    var inner=document.getElementById('playerWrap_inner');\n    if(!inner){inner=document.createElement('div');inner.id='playerWrap_inner';inner.style.cssText='position:absolute;inset:0;width:100%;height:100%;';wrap.appendChild(inner);}\n    var f=document.createElement('iframe');\n    f.id='mainFrame';f.src=url;f.allowFullscreen=true;\n    f.setAttribute('allow','autoplay;fullscreen;encrypted-media');\n    f.setAttribute('scrolling','no');\n    f.style.cssText='position:absolute;inset:0;width:100%;height:100%;border:none;z-index:1;';\n    inner.appendChild(f);\n    document.getElementById('srv1').classList.toggle('active',n===1);\n    var s2=document.getElementById('srv2');\n    if(s2&&!s2.disabled)s2.classList.toggle('active',n===2);\n    CURRENT_SERVER=n;\n    rememberServer(n);\n    setPlayerHealth(true,'SERVER '+n+' ACTIVE');\n    updateModernServerUI(n);\n    var hint=document.getElementById('serverHint');\n    if(hint)hint.textContent='Preferred server: Server '+n+' (saved on this device).';\n    showPlayerToast('Switched to Server '+n);\n    var f=document.getElementById('mainFrame');\n    if(f){f.addEventListener('load',function(){setPlayerHealth(true,'SERVER '+n+' READY');},{once:true}); }\n}\n\n\n/* ===== 2026 SMART PLAYER FUNCTIONS ===== */\nvar CURRENT_SERVER = 1;\nvar EVENT_KEY = 'cs_watch_later_florida-panthers-at-buffalo-sabres';\nvar EVENT_SLUG = 'florida-panthers-at-buffalo-sabres';\n\nfunction showPlayerToast(msg){\n    var el=document.getElementById('playerToast');\n    if(!el){el=document.createElement('div');el.id='playerToast';el.className='player-toast';document.body.appendChild(el);}\n    el.textContent=msg;el.classList.add('show');clearTimeout(window.__pt);window.__pt=setTimeout(function(){el.classList.remove('show');},2200);\n}\nfunction setPlayerHealth(ok,msg){\n    var h=document.getElementById('streamHealth');var s=document.getElementById('streamHealthText');\n    if(!h||!s)return;h.classList.toggle('offline',!ok);s.textContent=msg;\n}\nfunction getFrame(){return document.getElementById('mainFrame');}\nfunction togglePlayerFullscreen(){\n    var wrap=document.getElementById('playerWrap');if(!wrap)return;\n    if(document.fullscreenElement){document.exitFullscreen?.();return;}\n    if(wrap.requestFullscreen){wrap.requestFullscreen().catch(function(){showPlayerToast('Fullscreen is not available in this browser.');});}\n    else showPlayerToast('Fullscreen is not available in this browser.');\n}\nfunction reconnectStream(){\n    var f=getFrame();\n    if(!f){showPlayerToast('Stream player is not ready yet.');return;}\n    var src=f.src;f.src='about:blank';setPlayerHealth(true,'RECONNECTING');\n    setTimeout(function(){f.src=src;showPlayerToast('Reconnecting to stream…');},180);\n}\nfunction toggleWatchLater(){\n    try{\n        var saved=localStorage.getItem(EVENT_KEY)==='1';\n        if(saved){localStorage.removeItem(EVENT_KEY);showPlayerToast('Removed from Watch Later');}\n        else{localStorage.setItem(EVENT_KEY,'1');showPlayerToast('Saved to Watch Later');}\n        updateWatchLaterUI();\n    }catch(e){showPlayerToast('Watch Later is unavailable in private mode.');}\n}\nfunction updateWatchLaterUI(){\n    var saved=false;try{saved=localStorage.getItem(EVENT_KEY)==='1';}catch(e){}\n    var b=document.getElementById('saveEventBtn'),bar=document.getElementById('watchLaterBar');\n    if(b){b.classList.toggle('active',saved);var sp=b.querySelector('span');if(sp)sp.textContent=saved?'Saved':'Watch Later';}\n    if(bar)bar.style.display=saved?'flex':'none';\n}\nfunction shareEvent(){\n    var data={title:document.title,url:window.location.href,text:'Watch Florida Panthers at Buffalo Sabres'};\n    if(navigator.share){navigator.share(data).then(function(){showPlayerToast('Share sheet opened');}).catch(function(){});}\n    else{copyLink();showPlayerToast('Link copied — ready to share');}\n}\nfunction toggleShortcuts(){document.getElementById('shortcutPanel')?.classList.toggle('open');}\nfunction rememberServer(n){try{localStorage.setItem('cs_preferred_server',String(n));}catch(e){}}\nfunction loadPreferredServer(){\n    // Server 1 always starts automatically.\n    // Server 2 only starts when user manually clicks it.\n}\nwindow.addEventListener('online',function(){setPlayerHealth(true,'ONLINE');});\nwindow.addEventListener('offline',function(){setPlayerHealth(false,'OFFLINE');showPlayerToast('Your internet connection is offline.');});\ndocument.addEventListener('fullscreenchange',function(){\n    var b=document.querySelector('.stream-tool[onclick*=\"togglePlayerFullscreen\"] span');\n    if(b)b.textContent=document.fullscreenElement?'Exit Fullscreen':'Fullscreen';\n});\ndocument.addEventListener('keydown',function(e){\n    if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName))return;\n    var k=e.key.toLowerCase();\n    if(k==='f'){e.preventDefault();togglePlayerFullscreen();}\n    else if(k==='t'){e.preventDefault();toggleTheaterMode();}\n    else if(k==='r'){e.preventDefault();reconnectStream();}\n    else if(k==='1'){e.preventDefault();switchServer(1);}\n    else if(k==='2'){e.preventDefault();if(document.getElementById('srv2')&&!document.getElementById('srv2').disabled)switchServer(2);}\n    else if(k==='escape'){document.getElementById('shortcutPanel')?.classList.remove('open');}\n});\n\nfunction copyLink(){\n    navigator.clipboard.writeText('https://ihdstreams.top/watch/florida-panthers-at-buffalo-sabres').then(function(){\n        var el=document.getElementById('copiedMsg');\n        el.textContent=' Copied! Share with friends!';\n        setTimeout(function(){el.textContent='';},3000);\n    });\n}\n\n// Theater Mode Toggle Function\nfunction toggleTheaterMode() {\n    document.body.classList.toggle('theater-mode');\n    var isTheater = document.body.classList.contains('theater-mode');\n    document.getElementById('theaterText').textContent = isTheater ? 'Exit Theater' : 'Theater Mode';\n}\n\ntry{updateWatchLaterUI();}catch(e){}\nsetTimeout(loadPreferredServer,400);\n</script>"
