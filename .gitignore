# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/dist-electron/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

/.unused-scaffold/
/.sites-scaffold/
/source-inspection.html
/event-inspection.html
*.tsbuildinfo
  /.desktop-runtime/
# Written by `desktop/main.cjs` on every development launch so electron-updater has a feed
# to read while the app is unpackaged. It is machine state, not a build input.
dev-app-update.yml
