{
  "name": "sunday-room",
  "version": "1.0.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.6"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/web-server.mjs dev",
    "build": "next build",
    "start": "node scripts/web-server.mjs start",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "storybook:check": "node scripts/check-storybook-coverage.mjs",
    "storybook:media": "node scripts/generate-storybook-media.mjs",
    "lint": "eslint . --max-warnings=0",
    "pretest": "node -e \"require('electron')\"",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "desktop": "node scripts/desktop.mjs",
    "desktop:icons": "node desktop/icons/generate.mjs",
    "desktop:icons:check": "node desktop/icons/generate.mjs --check",
    "desktop:branding": "node tests/desktop-branding.mjs",
    "desktop:package": "npm run desktop:icons && node scripts/prepare-desktop.mjs && electron-builder --win nsis --x64 --publish never && node tests/desktop-branding.mjs --packaged",
    "desktop:smoke": "node tests/packaged-desktop.mjs",
    "test:player": "node tests/player.browser.mjs",
    "test:player:desktop": "node tests/player.browser.mjs --desktop",
    "test:catalog:desktop": "node scripts/verify-sportsurge-catalog.mjs",
    "verify:observer": "node --experimental-strip-types tests/verify-sportsurge-observer.mjs",
    "diagnostics:football": "node --experimental-strip-types scripts/football-diagnostics.mjs",
    "catalog:college": "node scripts/generate-college-team-catalog.mjs",
    "catalog:college:check": "node scripts/generate-college-team-catalog.mjs --check",
    "catalog:college:replay": "node --experimental-strip-types scripts/replay-college-team-catalog.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.6.13",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-boundaries": "^7.2.0",
    "ffmpeg-static": "^5.3.0",
    "js-yaml": "4.1.1",
    "playwright": "^1.63.0",
    "resedit": "1.7.2",
    "sharp": "0.35.4",
    "storybook": "10.6.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
